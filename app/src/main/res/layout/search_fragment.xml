<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/activity_padding">
    <ImageView
        android:id="@+id/iv_back"
        android:layout_width="@dimen/icon_size"
        android:layout_height="@dimen/icon_size"
        android:src="@drawable/outline_arrow_back_24"
        app:layout_constraintBottom_toBottomOf="@+id/et_search"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/et_search"
        android:layout_width="0dp"
        android:layout_height="@dimen/search_bar_height"
        android:hint="@string/search_hint"
        android:background="@drawable/search_bar_bg"
        android:layout_marginHorizontal="@dimen/five_dp"
        app:layout_constraintStart_toEndOf="@id/iv_back"
        android:padding="@dimen/five_dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:textSize="@dimen/search_bar_text_size"
        android:textColor="@color/black"
        android:clickable="true"
        />
    <ImageView
        android:id="@+id/iv_clear_text"
        android:layout_width="@dimen/clear_icon_size"
        android:layout_height="@dimen/clear_icon_size"
        android:padding="@dimen/clear_icon_padding"
        android:src="@drawable/outline_close_24"
        android:background="@drawable/close_icon_bg"
        android:layout_marginHorizontal="@dimen/five_dp"
        app:layout_constraintRight_toLeftOf="@+id/iv_search"
        app:layout_constraintTop_toTopOf="@+id/iv_search"
        app:layout_constraintBottom_toBottomOf="@+id/iv_search"
        android:clickable="true"
        android:visibility="gone"
        />

    <ImageView
        android:id="@+id/iv_search"
        android:layout_width="@dimen/search_icon_size"
        android:layout_height="@dimen/search_icon_size"
        android:layout_marginEnd="@dimen/search_icon_margin_end"
        android:background="@drawable/search_icon"
        android:padding="@dimen/search_icon_padding"
        android:src="@drawable/search_bar_icon"
        app:layout_constraintEnd_toEndOf="@id/et_search"
        app:layout_constraintBottom_toBottomOf="@id/et_search"
        app:layout_constraintTop_toTopOf="@id/et_search"
        android:clickable="true"
        />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/recycler_view_margin_top"
        app:layout_constraintTop_toBottomOf="@+id/et_search"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="@dimen/progressbar_margin_bottom"/>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btn_scroll_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/outline_arrow_circle_up_24"
        android:contentDescription="@string/scroll_to_top"
        app:backgroundTint="@color/blibliBlue"
        app:tint="@android:color/white"
        android:layout_margin="@dimen/fab_margin"
        android:clickable="true"
        app:maxImageSize="@dimen/fab_max_image_size"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
        <include
        android:id="@+id/noProductsInclude"
        layout="@layout/data_not_found"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:visibility="gone"
        />

</androidx.constraintlayout.widget.ConstraintLayout>
