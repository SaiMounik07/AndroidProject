<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_card_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">
    <ImageView
        android:id="@+id/iv_product_image"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_marginStart="@dimen/five_dp"
        android:layout_marginBottom="10dp"
        android:src="@drawable/img_1"
        android:background="@drawable/rounded_corners"
        android:clipToOutline="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <ImageView
        android:id="@+id/free_shipping_logo"
        android:layout_width="50dp"
        android:layout_height="20dp"
        android:src="@drawable/img_4"
        app:layout_constraintBottom_toBottomOf="@id/iv_product_image"
        app:layout_constraintStart_toStartOf="@id/iv_product_image"
        app:layout_constraintEnd_toStartOf="@+id/iv_flashsale"
        />

    <ImageView
        android:id="@+id/iv_flashsale"
        android:layout_width="50dp"
        android:layout_height="20dp"
        android:layout_marginHorizontal="@dimen/five_dp"
        android:src="@drawable/img_5"
        app:layout_constraintBottom_toBottomOf="@id/iv_product_image"
        app:layout_constraintStart_toEndOf="@+id/free_shipping_logo"
        app:layout_constraintLeft_toLeftOf="@+id/iv_product_image"
        />




    <TextView
        android:id="@+id/product_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="10dp"
        android:textSize="14sp"
        android:text="Prodigo * Sepatu Lari Pria Gaspar I Sepatu Sneakers I Sepatu Olahraga I Running Shoes"
        app:layout_constraintStart_toEndOf="@id/iv_product_image"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <TextView
        android:id="@+id/product_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rp170.800.000"
        android:textColor="@color/blibliBlue"
        android:textSize="14sp" />


    <TextView
        android:id="@+id/tv_actual_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="400.0000"
        android:textColor="@color/greyName"
        android:textSize="10sp"
        />

    <TextView
        android:id="@+id/tv_discount_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="40%"
        android:background="@drawable/discount_background"
        android:textColor="@color/dicount_text_red"
        android:padding="3dp"
        android:textSize="10sp"
        android:layout_marginEnd="10dp"
        />

    <androidx.constraintlayout.helper.widget.Flow
        android:id="@+id/flow_price"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        app:flow_horizontalBias="0"
        android:layout_marginEnd="10dp"
    app:constraint_referenced_ids="product_price,tv_actual_price,tv_discount_percent"
    app:flow_horizontalGap="3dp"
    app:flow_horizontalStyle="packed"
    app:flow_wrapMode="aligned"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toEndOf="@id/iv_product_image"
    app:layout_constraintTop_toBottomOf="@id/product_name" />

    <TextView
        android:id="@+id/tv_free_shipping_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hadiah gratis"
        android:background="@drawable/free_shipping_backgroud"
        android:textColor="@color/free_shipping_text_color"
        android:padding="4dp"
        android:textSize="12sp"
        />

    <TextView
        android:id="@+id/tv_discount_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Diskon 10%"
        android:background="@drawable/discount_label"
        android:textColor="@color/discount_label_text"
        android:padding="4dp"
        android:textSize="12sp" />

    <androidx.constraintlayout.helper.widget.Flow
        android:id="@+id/flow_labels"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        app:constraint_referenced_ids="tv_free_shipping_text,tv_discount_label"
        app:flow_horizontalGap="8dp"
        app:flow_horizontalStyle="packed"
        app:flow_wrapMode="none"
        app:layout_constraintStart_toEndOf="@id/iv_product_image"
        app:layout_constraintTop_toBottomOf="@id/flow_price" />

    <ImageView
        android:id="@+id/iv_rating_star"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/star"

         />
    <ImageView
        android:id="@+id/iv_shop_rating"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/shop"

        />

    <TextView
        android:id="@+id/tv_rating"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="5"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/dot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="·"
        android:textColor="@color/greyName"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tv_sold_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Terjual"
        android:textColor="@color/greyName"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tv_sold_numbers"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="5"
        android:textColor="@color/greyName"
        android:textSize="13sp" />

    <androidx.constraintlayout.helper.widget.Flow
        android:id="@+id/flow_rating"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        app:constraint_referenced_ids="iv_rating_star,iv_shop_rating,tv_rating,dot,tv_sold_text,tv_sold_numbers"
        app:flow_horizontalGap="4dp"
        app:flow_horizontalStyle="packed"
        app:flow_wrapMode="none"
        app:layout_constraintStart_toEndOf="@id/iv_product_image"
        app:layout_constraintTop_toBottomOf="@id/flow_labels"

        />

    <ImageView
        android:id="@+id/iv_official_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/img_2" />

    <ImageView
        android:id="@+id/iv_diamond_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/img_3"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/tv_store_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Prodigo Flagship Store"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/greyName"
        android:textSize="13sp" />

    <androidx.constraintlayout.helper.widget.Flow
        android:id="@+id/flow_store"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        app:constraint_referenced_ids="iv_official_icon,iv_diamond_icon,tv_store_name"
        app:flow_horizontalGap="1dp"
        android:layout_marginVertical="4dp"
        app:flow_horizontalStyle="packed"
        app:flow_wrapMode="none"
        app:layout_constraintStart_toEndOf="@id/iv_product_image"
        app:layout_constraintTop_toBottomOf="@id/flow_rating" />
    <com.google.android.material.button.MaterialButton
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:id="@+id/show_product"
        app:layout_constraintTop_toBottomOf="@id/flow_store"
        app:layout_constraintStart_toEndOf="@id/iv_product_image"
        app:layout_constraintRight_toRightOf="parent"
        android:text="Lihat Produk"
        android:textColor="@color/white"
        android:backgroundTint="@color/blibliBlue"
        app:cornerRadius="10dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="@dimen/five_dp"
        app:layout_constraintBottom_toBottomOf="parent"
        />
</androidx.constraintlayout.widget.ConstraintLayout>
